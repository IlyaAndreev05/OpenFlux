# Copy to .env and replace every placeholder before starting the stack.
OPENFLUX_DOMAIN=openflux.example.com
ACME_EMAIL=admin@example.com
# Generate a long random token, for example: openssl rand -hex 32
OPENFLUX_ADMIN_TOKEN=replace-with-64-hex-characters
# Create a node in Control first; set these before using Compose profile local-node.
OPENFLUX_NODE_ID=
OPENFLUX_NODE_TOKEN=
OPENFLUX_EXIT_MODE=l4
OPENFLUX_PANEL_PASSWORD=replace-with-a-long-unique-password
# URL-safe random value. Required for Postgres URI mode; retain across restores.
POSTGRES_PASSWORD=replace-with-url-safe-random-password
# Name of an existing Remnawave Docker network for the optional local Xray route.
REMNAWAVE_DOCKER_NETWORK=remnawave_default
