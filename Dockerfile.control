# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/openflux-control ./cmd/openflux-control \
 && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/openfluxctl ./cmd/openfluxctl

FROM alpine:3.22
RUN apk add --no-cache ca-certificates sqlite wget \
 && addgroup -S -g 10001 openflux \
 && adduser -S -D -H -u 10001 -G openflux openflux \
 && mkdir -p /data /backup \
 && chown -R openflux:openflux /data /backup
COPY --from=build /out/openflux-control /usr/local/bin/openflux-control
COPY --from=build /out/openfluxctl /usr/local/bin/openfluxctl
USER 10001:10001
ENV OPENFLUX_DB_DRIVER=sqlite \
    OPENFLUX_SQLITE_PATH=/data/openflux-control.db \
    OPENFLUX_INSTALLATION_KEY_FILE=/data/installation.key \
    OPENFLUX_CONTROL_ADDR=:8787
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD wget -q -O - http://127.0.0.1:8787/healthz >/dev/null || exit 1
ENTRYPOINT ["/usr/local/bin/openflux-control"]
